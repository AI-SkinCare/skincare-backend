# 가짜 값만 둔다. 실제 값은 담당자에게 1:1로만 전달한다 (TRD §6).
# 비밀키 생성: openssl rand -base64 48

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://skincare:local-dev-password@localhost:5432/skincare

JWT_ACCESS_SECRET=change-me-access-secret-not-real
JWT_REFRESH_SECRET=change-me-refresh-secret-not-real

CORS_ORIGIN=http://localhost:5173

# fixture | real — real이면 AI_BASE_URL·AI_INTERNAL_TOKEN 필수
AI_MODE=fixture
AI_BASE_URL=
AI_INTERNAL_TOKEN=
AI_SKIN_TIMEOUT_MS=20000
AI_REC_TIMEOUT_MS=130000
AI_HEALTH_INTERVAL_MS=30000
# ok | no-face | rec-timeout | rec-slow | ai-down
AI_FIXTURE_SCENARIO=ok

# 1 외의 값이면 기동 실패
REC_WORKER_CONCURRENCY=1
REC_QUEUE_LIMIT=10
REC_QUEUE_MAX_WAIT_MIN=60
ANALYSIS_DAILY_LIMIT=20
LOGIN_RATE_PER_MIN=10
TRUST_PROXY=true

# 로컬 HTTP(시뮬레이터·실기기)에서만 false. production은 항상 true
COOKIE_SECURE=false
LOG_LEVEL=info

# npm run seed 계정 공통 비밀번호 (개발용)
SEED_PASSWORD=Skin!2026dev

# --- docker-compose 전용 (앱은 읽지 않음) ---
POSTGRES_USER=skincare
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=skincare
# 운영 서버의 cloudflared 터널 토큰
TUNNEL_TOKEN=
